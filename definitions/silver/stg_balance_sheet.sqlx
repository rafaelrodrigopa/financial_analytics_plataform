config {
  type: "table",
  schema: "silver",
  name: "stg_balance_sheet",
  tags: ["silver", "financial_statements"],
  bigquery: {
    partitionBy: "date",
    clusterBy: ["symbol"]
  },
  assertions: {
    uniqueKey: ["symbol", "date", "period"],
    nonNull: ["symbol", "date", "period"]
  },
  description: "Demonstrativo limpo, padronizado e desduplicado do Balanço Patrimonial (Balance Sheet Statement)."
}

SELECT
  CAST(date AS DATE) AS date,
  CAST(symbol AS STRING) AS symbol,
  CAST(period AS STRING) AS period,
  CAST(fiscalYear AS STRING) AS fiscal_year,
  CAST(totalAssets AS NUMERIC) AS total_assets,

  CAST(totalLiabilities AS NUMERIC) AS total_liabilities,
  CAST(totalStockholdersEquity AS NUMERIC) AS total_equity,
  CAST(netDebt AS NUMERIC) AS net_debt,
  CAST(_ingested_at AS TIMESTAMP) AS _ingested_at,
  CAST(_source AS STRING) AS _source,
  CAST(_execution_id AS STRING) AS _execution_id,
  CAST(_row_hash AS STRING) AS _row_hash,
  _raw_payload
FROM
  ${ref("fmp_balance_sheet")}
QUALIFY ROW_NUMBER() OVER (PARTITION BY symbol, date, period ORDER BY _ingested_at DESC) = 1
