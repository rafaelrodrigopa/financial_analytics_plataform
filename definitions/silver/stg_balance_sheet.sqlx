config {
  type: "table",
  schema: "silver",
  name: "stg_balance_sheet",
  tags: ["silver", "financial_statements"],
  bigquery: {
    partitionBy: "date",
    clusterBy: ["symbol"]
  },
  assertions: {
    uniqueKey: ["symbol", "date", "period"],
    nonNull: ["symbol", "date", "period"]
  },
  description: "Demonstrativo limpo, padronizado e desduplicado do Balanço Patrimonial (Balance Sheet Statement).",
  columns: {
    date: "Data de encerramento do período fiscal do balanço patrimonial.",
    symbol: "Código de negociação do ativo na bolsa (ticker symbol, ex: AAPL).",
    period: "Período fiscal do demonstrativo (ex: FY, Q1, Q2, Q3, Q4).",
    fiscal_year: "Ano fiscal correspondente ao demonstrativo.",
    total_assets: "Ativo Total da empresa em moeda original.",
    total_liabilities: "Passivo Total da empresa em moeda original.",
    total_equity: "Patrimônio Líquido Total pertencente aos acionistas.",
    net_debt: "Dívida Líquida (Dívida Total menos Caixa e Equivalentes).",
    _ingested_at: "Timestamp de ingestão do registro na camada Bronze.",
    _source: "Origem do dado (ex: FMP_API).",
    _execution_id: "Identificador único da execução da pipeline de ETL.",
    _row_hash: "Hash MD5 da linha para controle de alteração e deduplicação.",
    _raw_payload: "Payload JSON bruto original retornado pela API."
  }
}

SELECT
  CAST(date AS DATE) AS date,
  CAST(symbol AS STRING) AS symbol,
  CAST(period AS STRING) AS period,
  CAST(fiscalYear AS STRING) AS fiscal_year,
  CAST(totalAssets AS NUMERIC) AS total_assets,

  CAST(totalLiabilities AS NUMERIC) AS total_liabilities,
  CAST(totalStockholdersEquity AS NUMERIC) AS total_equity,
  CAST(netDebt AS NUMERIC) AS net_debt,
  CAST(_ingested_at AS TIMESTAMP) AS _ingested_at,
  CAST(_source AS STRING) AS _source,
  CAST(_execution_id AS STRING) AS _execution_id,
  CAST(_row_hash AS STRING) AS _row_hash,
  _raw_payload
FROM
  ${ref("fmp_balance_sheet")}
QUALIFY ROW_NUMBER() OVER (PARTITION BY symbol, date, period ORDER BY _ingested_at DESC) = 1
