config {
  type: "table",
  schema: "silver",
  name: "dim_company_profile",
  tags: ["silver", "dimensions"],
  bigquery: {
    clusterBy: ["symbol", "sector"]
  },
  assertions: {
    uniqueKey: ["symbol"],
    nonNull: ["symbol", "company_name"]
  },
  description: "Dimensão higienizada e desduplicada do Perfil Corporativo das empresas.",
  columns: {
    symbol: "Código de negociação do ativo na bolsa (ticker symbol, ex: AAPL).",
    company_name: "Razão social / Nome oficial da empresa.",
    currency: "Moeda padrão de negociação e reportes (ex: USD).",
    exchange: "Bolsa de valores onde o ativo é negociado (ex: NASDAQ, NYSE).",
    industry: "Indústria de atuação da empresa.",
    sector: "Setor econômico da empresa (ex: Technology, Healthcare).",
    country: "País de sede corporativa da empresa.",
    market_cap: "Capitalização de mercado (Valor de Mercado) da empresa.",
    _ingested_at: "Timestamp de ingestão do registro na camada Bronze.",
    _source: "Origem do dado (ex: FMP_API).",
    _execution_id: "Identificador único da execução da pipeline de ETL.",
    _row_hash: "Hash MD5 da linha para controle de alteração e deduplicação.",
    _raw_payload: "Payload JSON bruto original retornado pela API."
  }
}

SELECT
  CAST(symbol AS STRING) AS symbol,
  CAST(companyName AS STRING) AS company_name,
  CAST(currency AS STRING) AS currency,
  CAST(exchange AS STRING) AS exchange,
  CAST(industry AS STRING) AS industry,
  CAST(sector AS STRING) AS sector,
  CAST(country AS STRING) AS country,
  CAST(marketCap AS NUMERIC) AS market_cap,
  CAST(_ingested_at AS TIMESTAMP) AS _ingested_at,

  CAST(_source AS STRING) AS _source,
  CAST(_execution_id AS STRING) AS _execution_id,
  CAST(_row_hash AS STRING) AS _row_hash,
  _raw_payload
FROM
  ${ref("fmp_company_profile")}
QUALIFY ROW_NUMBER() OVER (PARTITION BY symbol ORDER BY _ingested_at DESC) = 1
