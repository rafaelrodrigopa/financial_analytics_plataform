config {
  type: "table",
  schema: "silver",
  name: "stg_quote",
  tags: ["silver", "quotes"],
  bigquery: {
    partitionBy: "DATE(_ingested_at)",
    clusterBy: ["symbol"]
  },
  assertions: {
    uniqueKey: ["symbol", "_ingested_at"],
    nonNull: ["symbol", "price", "_ingested_at"]
  },
  description: "Cotações em tempo real desduplicadas e limpas.",
  columns: {
    symbol: "Código de negociação do ativo na bolsa (ticker symbol, ex: AAPL).",
    price: "Preço atual de mercado do ativo.",
    change_percent: "Variação percentual do preço no dia.",
    change_amount: "Variação nominal do preço no dia.",
    day_low: "Mínima do preço atingida no dia.",
    day_high: "Máxima do preço atingida no dia.",
    year_high: "Máxima do preço atingida nas últimas 52 semanas.",
    year_low: "Mínima do preço atingida nas últimas 52 semanas.",
    market_cap: "Capitalização de mercado (Valor de Mercado) atual do ativo.",
    volume: "Volume total de ações negociadas no dia.",
    _ingested_at: "Timestamp de ingestão da cotação na camada Bronze.",
    _source: "Origem do dado (ex: FMP_API).",
    _execution_id: "Identificador único da execução da pipeline de ETL.",
    _row_hash: "Hash MD5 da linha para controle de alteração e deduplicação.",
    _raw_payload: "Payload JSON bruto original retornado pela API."
  }
}

SELECT
  UPPER(TRIM(CAST(symbol AS STRING))) AS symbol,
  CAST(price AS NUMERIC) AS price,
  CAST(changePercentage AS FLOAT64) AS change_percent,
  CAST(change AS NUMERIC) AS change_amount,
  CAST(dayLow AS NUMERIC) AS day_low,
  CAST(dayHigh AS NUMERIC) AS day_high,
  CAST(yearHigh AS NUMERIC) AS year_high,
  CAST(yearLow AS NUMERIC) AS year_low,
  CAST(marketCap AS NUMERIC) AS market_cap,
  CAST(volume AS INT64) AS volume,
  ${audit_fields.selectAuditFields()}
FROM
  ${ref("fmp_quote")}
QUALIFY ROW_NUMBER() OVER (PARTITION BY UPPER(TRIM(symbol)), DATE(_ingested_at) ORDER BY _ingested_at DESC) = 1
