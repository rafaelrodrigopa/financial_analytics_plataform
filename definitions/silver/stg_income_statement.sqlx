config {
  type: "table",
  schema: "silver",
  name: "stg_income_statement",
  tags: ["silver", "financial_statements", "quarterly"],
  bigquery: {
    partitionBy: "date",
    clusterBy: ["symbol"]
  },
  assertions: {
    uniqueKey: ["symbol", "date", "period"],
    nonNull: ["symbol", "date", "period"]
  },
  description: "Demonstrativo limpo, padronizado e desduplicado do DRE (Income Statement).",
  columns: {
    date: "Data de encerramento do período fiscal do DRE.",
    symbol: "Código de negociação do ativo na bolsa (ticker symbol, ex: AAPL).",
    period: "Período fiscal do demonstrativo (ex: FY, Q1, Q2, Q3, Q4).",
    fiscal_year: "Ano fiscal correspondente ao demonstrativo.",
    revenue: "Receita Líquida Total de vendas no período.",
    gross_profit: "Lucro Bruto (Receita menos Custo dos Produtos/Serviços Vendidos).",
    operating_income: "Lucro Operacional (EBIT).",
    net_income: "Lucro Líquido final apurado no período.",
    eps: "Lucro por Ação (Earnings Per Share).",
    _ingested_at: "Timestamp de ingestão do registro na camada Bronze.",
    _source: "Origem do dado (ex: FMP_API).",
    _execution_id: "Identificador único da execução da pipeline de ETL.",
    _row_hash: "Hash MD5 da linha para controle de alteração e deduplicação.",
    _raw_payload: "Payload JSON bruto original retornado pela API."
  }
}

SELECT
  CAST(date AS DATE) AS date,
  UPPER(TRIM(CAST(symbol AS STRING))) AS symbol,
  NULLIF(TRIM(CAST(period AS STRING)), '') AS period,
  NULLIF(TRIM(CAST(fiscalYear AS STRING)), '') AS fiscal_year,
  CAST(revenue AS NUMERIC) AS revenue,

  CAST(grossProfit AS NUMERIC) AS gross_profit,
  CAST(operatingIncome AS NUMERIC) AS operating_income,
  CAST(netIncome AS NUMERIC) AS net_income,
  CAST(eps AS FLOAT64) AS eps,
  ${audit_fields.selectAuditFields()}
FROM
  ${ref("fmp_income_statement")}
QUALIFY ROW_NUMBER() OVER (PARTITION BY UPPER(TRIM(symbol)), date, NULLIF(TRIM(period), '') ORDER BY _ingested_at DESC) = 1
