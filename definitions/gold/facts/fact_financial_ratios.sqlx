config {
  type: "table",
  schema: "gold",
  name: "fact_financial_ratios",
  tags: ["gold", "facts", "ratios", "financial_indicators"],
  bigquery: {
    partitionBy: "DATE(_ingested_at)",
    clusterBy: ["codigo_ativo", "periodo"]
  },
  assertions: {
    uniqueKey: ["codigo_ativo", "data_referencia", "periodo"],
    nonNull: ["codigo_ativo", "data_referencia", "periodo"]
  },
  description: "Fato de indicadores, índices financeiros e métricas de crescimento (YoY e QoQ) calculados a partir dos demonstrativos consolidados.",
  columns: {
    codigo_ativo: "Código de negociação do ativo na bolsa (ex: AAPL).",
    data_referencia: "Data de encerramento do período fiscal do demonstrativo.",
    periodo: "Período fiscal do demonstrativo (ex: FY, Q1, Q2, Q3, Q4).",
    ano_fiscal: "Ano fiscal correspondente ao demonstrativo.",
    margem_bruta: "Margem Bruta em percentual (%): (Lucro Bruto / Receita Líquida) * 100.",
    margem_operacional: "Margem Operacional em percentual (%): (Lucro Operacional / Receita Líquida) * 100.",
    margem_liquida: "Margem Líquida em percentual (%): (Lucro Líquido / Receita Líquida) * 100.",
    roe: "Retorno sobre o Patrimônio Líquido - ROE em percentual (%): (Lucro Líquido / Patrimônio Líquido) * 100.",
    conversao_caixa: "Taxa de Conversão de Caixa em percentual (%): (Fluxo de Caixa Livre / Lucro Líquido) * 100.",
    crescimento_receita_yoy: "Crescimento percentual da Receita Líquida em relação ao mesmo trimestre do ano anterior (YoY %).",
    crescimento_receita_qoq: "Crescimento percentual da Receita Líquida em relação ao trimestre imediatamente anterior (QoQ %).",
    crescimento_lucro_yoy: "Crescimento percentual do Lucro Líquido em relação ao mesmo trimestre do ano anterior (YoY %).",
    crescimento_lucro_qoq: "Crescimento percentual do Lucro Líquido em relação ao trimestre imediatamente anterior (QoQ %).",
    _ingested_at: "Timestamp da última atualização dos dados."
  }
}

WITH base AS (
  SELECT * FROM ${ref("fact_financial_statements")}
)

SELECT
  codigo_ativo,
  data_referencia,
  periodo,
  ano_fiscal,

  -- Índices e Margens Financeiras (%)
  SAFE_DIVIDE(lucro_bruto, receita_liquida) * 100 AS margem_bruta,
  SAFE_DIVIDE(lucro_operacional, receita_liquida) * 100 AS margem_operacional,
  SAFE_DIVIDE(lucro_liquido, receita_liquida) * 100 AS margem_liquida,
  SAFE_DIVIDE(lucro_liquido, patrimonio_liquido) * 100 AS roe,
  SAFE_DIVIDE(fluxo_caixa_livre, lucro_liquido) * 100 AS conversao_caixa,

  -- Indicadores de Crescimento Temporal (YoY e QoQ %)
  SAFE_DIVIDE(
    receita_liquida - LAG(receita_liquida, 4) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia),
    ABS(LAG(receita_liquida, 4) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia))
  ) * 100 AS crescimento_receita_yoy,

  SAFE_DIVIDE(
    receita_liquida - LAG(receita_liquida, 1) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia),
    ABS(LAG(receita_liquida, 1) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia))
  ) * 100 AS crescimento_receita_qoq,

  SAFE_DIVIDE(
    lucro_liquido - LAG(lucro_liquido, 4) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia),
    ABS(LAG(lucro_liquido, 4) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia))
  ) * 100 AS crescimento_lucro_yoy,

  SAFE_DIVIDE(
    lucro_liquido - LAG(lucro_liquido, 1) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia),
    ABS(LAG(lucro_liquido, 1) OVER (PARTITION BY codigo_ativo ORDER BY data_referencia))
  ) * 100 AS crescimento_lucro_qoq,

  _ingested_at
FROM
  base
